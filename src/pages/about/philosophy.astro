---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Content2Col from '../../components/Content2Col.astro';
import Content1Col from '../../components/Content1Col.astro';
import CardSection from '../../components/CardSection.astro';
import heroimg from '../../assets/philosophy-hero-01.avif';
import phil1 from '../../assets/philosophy-triage-diagram.svg';
import phil2 from '../../assets/philosophy-middle-02.avif';
import phil3 from '../../assets/philosophy-middle-03.avif';

---

<Layout 
  title="교육 및 운영 철학 | 제주발도르프어린이집 (제주시 한경·안덕)"
  description="제주 발도르프 어린이집의 교육 및 운영 철학을 소개합니다.">

  <Hero
    image={heroimg}
    title="운영 철학"
    imageAlt="운영 철학"
  />
  
  <Content1Col
    title="제주 발도르프 어린이집은 <br />어린이집, 가정, 지역사회가 함께하는 <br /> 교육공동체를 지향합니다."
    titleTag="h3"
    description="영유아들이 개별성을 존중받으며 몸과 마음이 건강하게 자랄 수 있는 터전,<br /> 부모들의 양육과 교육에 신뢰할 수 있는 안내와 도움을 줄 수 있는 곳,<br />교사들이 마음껏 교육관을 펼칠 수 있는 일터,<br />그곳에 참여한 모든 이들이 교육공동체를 통해 아이와 함께 삶을 가꾸고 성숙해 가는 어린이집이 됩니다."
    titleColor="rose"
    textColor="brown"
    bgColor="bgPink"
  />

  <Content2Col
    image={phil2}
    imagePosition="right"
    imageAlt="모방이미지"
    label="원훈"
    labelColor="rose"
    title="따뜻하고 부드럽고 신나게 <br />아이들이 꽃처럼 피어나는 곳"
    titleColor="brown"
    textAlign="middle"
    titleTag="h3"
  />

  <Content2Col
    image={phil3}
    imagePosition="left"
    imageAlt="모방이미지"
    label="설립 목적"
    labelColor="rose"
    title="아이 자신의 고유성과 개별성을<br /> 조화롭게 키우는 공동체"
    titleColor="brown"
    textAlign="middle"
    titleTag="h3"
    description="우리 어린이집은 발도르프 교육의 인간에 대한 이해를 바탕으로 아이와 부모와 교사가 만나는 교육의 장입니다.<br /> <br />  아이 각자의 고유성과 개별성을 조화롭게 잘 키울 수 있도록, 부모는 소통하고 고민을 나누며, 교사는 교육 내용을 책임집니다. <br />성별, 지역, 계층 및 신체나 정신의 장애에 따른 차별과 불평등 없이 아이들이 건강하고 행복하게 자랄 수 있도록 하는데<br /> 설립 목적이 있습니다."
  />  
</Layout>