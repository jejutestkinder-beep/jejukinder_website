---
import { Image } from 'astro:assets';

interface Props {
  image?: any;
  title: string;
  description?: string;
  imageAlt?: string;
  gradient?: string;
  objectPosition?: string;
}

const { image, title, description, imageAlt = title, gradient, objectPosition = 'center' } = Astro.props;
---

<section class="relative overflow-hidden h-[60vh] min-h-[400px] md:h-[50vh] md:min-h-[300px] w-full">
  {image && (
    typeof image === 'string' ? (
      <img src={image} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover" style={`object-position: ${objectPosition};`} />
    ) : (
      <Image src={image} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover" style={`object-position: ${objectPosition};`} />
    )
  )}
  {gradient && (
    <div class={`absolute inset-0 ${gradient} bg-cover bg-center`}></div>
  )}
  <div class="absolute inset-0 bg-black/40 z-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full px-6 text-center z-20">
    <h2 class="text-white drop-shadow-lg m-0 mb-6 font-heading text-4xl md:text-5xl font-bold">{title}</h2>
    {description && (
      <h4 class="text-white drop-shadow-lg m-0 text-xl md:text-2xl font-medium font-body">{description}</h4>
    )}
  </div>
</section>

