---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Page } from 'astro';
import boardHeroImage from '../../assets/hero-board-stories.jpeg';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = await getCollection('board');

  // 최신순 정렬
  posts.sort((a, b) => {
    const ad = a.data.date ? new Date(a.data.date).getTime() : 0;
    const bd = b.data.date ? new Date(b.data.date).getTime() : 0;
    return bd - ad;
  });

  return paginate(posts, { pageSize: 15 });
}

interface Props {
  page: Page<CollectionEntry<'board'>>;
}

const { page } = Astro.props;
---

<Layout title="어린이집 이야기| 제주발도르프어린이집">
  <PostList 
    title="어린이집 이야기" 
    items={page.data} 
    type="board" 
    bgImage={boardHeroImage}
    imageAlt="어린이집 이야기"
    page={page} 
  />
</Layout>
