---
import Navigation from '../components/navigation.astro';
import Footer from '../components/SiteFooter.astro';
import '../styles/global.css';
import Schema from '../components/Schema.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  openGraph?: {
    title?: string;
    description?: string;
    image?: string;
    url?: string;
    type?: string;
  };
  twitterCard?: {
    title?: string;
    description?: string;
    image?: string;
    card?: 'summary' | 'summary_large_image';
  };
  keywords?: string;
  schemaType?: 'School' | 'Organization' | 'LocalBusiness' | 'Article';
  schemaData?: any;
  naverVerification?: string;
}

const { 
  title = '제주 발도르프 어린이집',
  description = '제주 발도르프 어린이집',
  canonical,
  keywords,
  schemaType = 'Organization',
  schemaData,
  naverVerification
} = Astro.props;

const safeTitle = typeof title === 'string' ? title : String(title ?? '');
const safeDescription = typeof description === 'string' ? description : String(description ?? '');
const safeKeywords = typeof keywords === 'string' ? keywords : keywords == null ? '' : String(keywords);
const safeCanonical = typeof canonical === 'string' ? canonical : canonical == null ? '' : String(canonical);
const canonicalUrl = safeCanonical || Astro.url.href;
const schemaImageUrl = Astro.site ? new URL('/seo-image.jpg', Astro.site).href : '/seo-image.jpg';
const resolvedSchemaData = schemaData ?? {
  "name": "제주발도르프어린이집",
  "alternateName": ["제주 발도르프 어린이집", "제주발도르프"],
  "description": "제주도에 위치한 발도르프 교육 철학을 실천하는 어린이집입니다.",
  "url": "https://jejuwaldorf-kinder.com",
  "logo": "https://jejuwaldorf-kinder.com/favicon.svg",
  "image": schemaImageUrl,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "제주특별자치도",
    "addressCountry": "KR"
  }
};
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		{naverVerification && <meta name="naver-site-verification" content={naverVerification} />}

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
		
		<title>{safeTitle}</title>
		<meta name="description" content={safeDescription} />
		{safeKeywords && <meta name="keywords" content={safeKeywords} />}
		<link rel="canonical" href={canonicalUrl} />
		<Schema type={schemaType} data={resolvedSchemaData} />
	</head>

	<body>
		<Navigation />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style>
	html {
		margin: 0;
		width: 100%;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
		overflow-x: clip; /* Modern way to hide overflow without breaking sticky */
	}

	main {
		width: 100%;
	}

	/* Responsive Breakpoints - Remove main padding to allow full-width sections */
	@media (max-width: 1024px) {
		main {
			padding: 0;
		}
	}

	@media (max-width: 768px) {
		main {
			padding: 0;
		}
	}

	@media (max-width: 480px) {
		main {
			padding: 0;
		}
	}
</style>