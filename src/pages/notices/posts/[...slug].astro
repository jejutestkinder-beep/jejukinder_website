---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const notices = await getCollection('notices');
  return notices.map((n) => ({
    params: { slug: n.slug },
    props: { entry: n },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const seoData = {
  title: entry.data.seo?.seo_title || entry.data.title,
  description: entry.data.seo?.seo_description || entry.body.substring(0, 160),
  keywords: entry.data.seo?.keywords,
  openGraph: {
    title: entry.data.seo?.seo_title || entry.data.title,
    description: entry.data.seo?.seo_description || entry.body.substring(0, 160),
    image: entry.data.image?.url
  }
};
---

<Layout {...seoData} schemaType="Article">
  <div class="max-w-4xl mx-auto py-12 px-6">
    <h1 class="mb-2">{entry.data.title}</h1>
    <div class="flex items-center gap-4 text-gray-500 mb-12 pb-8 border-b border-gray-100">
      <span>작성자: {entry.data.author}</span>
      <span>·</span>
      <span>{new Date(entry.data.date).toLocaleDateString('ko-KR')}</span>
    </div>

    {entry.data.image?.url && (
      <div class="mb-12 rounded-2xl overflow-hidden shadow-sm">
        <img 
          src={entry.data.image.url} 
          alt={entry.data.image.alt || ""} 
          class="w-full h-auto object-cover max-h-[500px]"
        />
      </div>
    )}

    <article class="prose max-w-none mb-16">
      <Content />
    </article>

    <div class="text-center">
      <a href="/notices/" class="btn btn-secondary">목록으로 돌아가기</a>
    </div>
  </div>
</Layout>
