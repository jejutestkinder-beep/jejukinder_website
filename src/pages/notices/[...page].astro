---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Page } from 'astro';
import noticeHeroImage from '../../assets/hero-notice-announcements.jpeg';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const notices = await getCollection('notices');

  // 최신순 정렬
  notices.sort((a, b) => {
    const ad = a.data.date ? new Date(a.data.date).getTime() : 0;
    const bd = b.data.date ? new Date(b.data.date).getTime() : 0;
    return bd - ad;
  });

  return paginate(notices, { pageSize: 15 });
}

interface Props {
  page: Page<CollectionEntry<'notices'>>;
}

const { page } = Astro.props;
---

<Layout title="공지사항 - 제주 발도르프 킨더">
  <PostList 
    title="공지사항" 
    items={page.data} 
    type="notice" 
    bgImage={noticeHeroImage}
    imageAlt="공지사항"
    page={page} 
  />
</Layout>
