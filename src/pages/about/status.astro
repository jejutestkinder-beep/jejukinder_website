---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Content2Col from '../../components/Content2Col.astro';
import Content1Col from '../../components/Content1Col.astro';
import CardSection from '../../components/CardSection.astro';
import stat1 from '../../assets/status-hero-01.avif';
import stat2 from '../../assets/philosophy-triage-diagram.svg';
import stat3 from '../../assets/status-middle-01.jpeg';
import stat4 from '../../assets/status-classroom-interior-1.jpeg';
import stat5 from '../../assets/status-classroom-interior-2.jpeg';
import stat6 from '../../assets/status-middle-05.avif';


---

<Layout 
  title="운영 현황 | 제주발도르프어린이집 (제주시 한경·안덕)"
  description="제주발도르프어린이집의 발자취와 현재 운영 시설 및 교사진을 소개합니다.">

  <Hero
    image={stat1}
    title="어린이집 현황"
    imageAlt="어린이집 현황"
    objectPosition="bottom"
  />
  
  <Content2Col
    image={stat2}
    imagePosition="left"
    imageAlt="교육공동체 다이어그램"
    title="제주발도르프 교육 공동체"
    description="제주 발도르프 어린이집은 <br />부모와 아이가 함께 행복하고 건강하게 성장하기 위한<br />제주발도르프 교육공동체의 일원입니다."
    titleColor="brown"
    textAlign="middle"
    titleTag="h3"
  />

  <Content2Col
    image={stat3}
    imagePosition="right"
    imageAlt="어린이집 현판 이미지"
    title="연혁"
    titleColor="brown"
    textAlign="middle"
    titleTag="h3"
    descriptionList={[
      "2024년 10월 16일 준비모임 : 김주아, 안경술, 용지향 (어린이집 인가준비)",
      "2024년 12월 24일 어린이집 운영위원모임 : 김주아, 신지현, 유지온, 용지항, 정윤후",
      "2025년 1월 11일 어린이집 설명회",
      "2025년 2월 13일 리모델링 시작",
      "2025년 3월 10일 어린이집 홍보시작",
      "2025년 8월 가정어린이집 인가 (9명 출발)"
    ]}
  />

  <CardSection
    title="어린이집 시설"
	titleColor="brown"
    bgColor="bgPink"
    titleCenter={false}
    titleTag="h3"
    features={[
      {
        image: stat4,
        title: "바다반",
        imageAlt: "바다반 보육실 사진",
        titleTag: "h5",
        cardType: "image"
      },
      {
        image: stat5,
        title: "오름반",
        imageAlt: "오름반 보육실 사진",
        titleTag: "h5",
        cardType: "image"
      }
    ]}
  />
  <Content2Col
    image={stat6}
    imagePosition="right"
    imageAlt="교사와 아이의 교감 이미지"
    title="어린이집 교사진"
    titleColor="brown"
    textAlign="middle"
    titleTag="h3"
    description="현재 제주발도르프어린이집교사들은 (사)한국슈타이너인지학센터에서 발행하는국제 발도르프 영유아전문교육과정을 마쳤습니다.<br /> 발도르프 교육의 이론과 실천을 배우고 국내외 발도르프 교육기관의 현장경험을 통해 전문가적 자질을 갖춘 교사입니다."
  />
</Layout>