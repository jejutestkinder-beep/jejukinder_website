---
import instagramIcon from '../assets/social_insta.svg';
import youtubeIcon from '../assets/social_youtube.svg';
import naverIcon from '../assets/social_naver.png';
import waldorfLogo from '../assets/waldorf-logo.png';
import { Image } from 'astro:assets';

const socialLinks = [
  {
    platform: 'instagram',
    href: 'https://www.instagram.com/jeju_waldorf_kinder',
    displayName: '제주 발도르프 어린이집',
    iconSrc: instagramIcon
  },
  {
    platform: '제주자유발도르프학교',
    href: 'https://blog.naver.com/jeju_waldorf',
    displayName: '제주자유발도르프학교',
    iconSrc: naverIcon
  },
  {
    platform: 'youtube',
    href: 'https://www.youtube.com/@제주발도르프',
    displayName: '제주자유발도르프유튜브',
    iconSrc: youtubeIcon
  }
];

const footerNav = [
  {
    title: '어린이집 소개',
    links: [
      { name: '운영 철학', href: '/about/philosophy/' },
      { name: '현황', href: '/about/status/' },
      { name: '자주 묻는 질문', href: '/about/faq/' },
      { name: '어린이집 후기', href: '/about/testimonial/' }
    ]
  },
  {
    title: '발도르프 교육',
    links: [
      { name: '발도르프 유아 교육', href: '/waldorf/education/' },
      { name: '어린이집 리듬 생활', href: '/waldorf/rhythm/' }
    ]
  },
  {
    title: '어린이집 소식',
    links: [
      { name: '공지 사항', href: '/notices/' },
      { name: '어린이집 이야기', href: '/board/' }
    ]
  },
  {
    title: '문의 및 지원',
    links: [
      { name: '입학 상담 신청', href: 'https://docs.google.com/forms/d/e/1FAIpQLSccyRwbI42sdBHoiWLcz7A-BywQAY7I7ce_NVQUo6puvjFsVA/viewform?usp=header' },
      { name: '문의하기', href: '/contact/' }
    ]
  }
];
---

<footer class="bg-[#2B1111] pt-20 pb-12 px-6 text-white border-t-4 border-custom-rose w-full mt-auto">
  <div class="max-w-[1200px] mx-auto">
    <!-- Mega Footer Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12 mb-20">
      {footerNav.map((section) => (
        <div class="flex flex-col gap-5">
          <h6 class="text-white font-bold text-lg mb-2">{section.title}</h6>
          <ul class="flex flex-col gap-4 list-none ml-0">
            {section.links.map((link) => (
              <li class="mb-0">
                <a 
                  href={link.href} 
                  class="text-gray-300 hover:text-white transition-colors text-sm sm:text-base no-underline"
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Divider -->
    <div class="w-full h-px bg-white/10 mb-12"></div>

    <!-- Bottom Section: Logo, Contact, Socials -->
    <div class="flex flex-col md:flex-row justify-between items-center md:items-start gap-12">
      <div class="flex flex-col items-center md:items-start gap-5">
        <a href="/" class="block mb-2">
          <Image src={waldorfLogo} alt="제주 발도르프 어린이집" class="h-8 w-auto brightness-0 invert opacity-80" />
        </a>
        <div class="text-center md:text-left text-gray-400">
          <p class="text-sm my-1">제주특별자치도 제주시 한경면 청수로 218</p>
          <p class="text-sm my-1">T. 064.803.3050 | © {new Date().getFullYear()} 제주발도르프어린이집</p>
        </div>
      </div>

      <div class="flex flex-col items-center md:items-end gap-8">
        <div class="flex gap-6">
          {socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-center hover:opacity-80 transition-opacity">
              {link.iconSrc ? (
                <Image src={link.iconSrc} alt={link.platform} class="w-8 h-8 transition-all duration-300 group-hover:scale-110 brightness-0 invert" />
              ) : (
                <svg class="transition-all duration-300 group-hover:scale-110" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><path d="M16,2C8.268,2,2,8.268,2,16s6.268,14,14,14,14-6.268,14-14S23.732,2,16,2ZM8.5,16c0-1.5,.5-3,1-4.5,.5-1,1-2,2-2.5,.5-.5,1.5-.5,2-.5h.5c.5,0,1,.5,1.5,1,.5,.5,.5,1.5,.5,2,0,1-.5,2-1,3-.5,1-1.5,2-2.5,2.5-1,.5-2,.5-3,.5h-.5c-.5,0-.5-.5-.5-1ZM16,28c-2.485,0-4.773-.759-6.682-2.051,.333-1.584,1.336-2.911,2.682-3.575,1.5-.739,3.182-1.151,4.882-1.151,.129,0,.256,.009,.384,.013-.238,.711-.383,1.463-.383,2.248,0,1.911,.793,3.638,2.066,4.867-1.042,.403-2.164,.649-3.349,.649ZM23.5,16c0,1.5-.5,3-1,4.5-.5,1-1,2-2,2.5-.5,.5-1.5,.5-2,.5h-.5c-.5,0-1-.5-1.5-1-.5-.5-.5-1.5-.5-2,0-1,.5-2,1-3,.5-1,1.5-2,2.5-2.5,1-.5,2-.5,3-.5h.5c.5,0,.5,.5,.5,1Z" fill="white"/></svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
