---
import { colors } from '../utils/colors';
import { Image } from 'astro:assets';

type ColorName = 'brown' | 'bgPink' | 'lightPink' | 'lightYellow' | 'grey' | 'darkGrey' | 'rose' | 'green' | 'white' | 'black' | string;

interface Props {
  image?: any;
  imagePosition?: 'left' | 'right';
  imageAlt?: string;
  imageShape?: 'rect' | 'organic';
  label?: string;
  labelColor?: 'rose' | 'white' | 'green';
  title?: string;
  description?: string;
  descriptionList?: string[];
  titleColor?: ColorName;
  textColor?: ColorName;
  textAlign?: 'top' | 'middle' | 'bottom';
  bgColor?: 'white' | 'gray' | string;
  titleTag?: 'h2' | 'h3';
  class?: string;
}

const {
  image,
  imagePosition = 'left',
  imageAlt = '',
  imageShape = 'rect',
  label,
  labelColor = 'rose',
  title,
  description,
  descriptionList,
  titleColor,
  textColor,
  textAlign = 'middle',
  bgColor = 'white',
  titleTag = 'h2',
  class: className = ''
} = Astro.props;

const TitleTag = titleTag;

const bgClass = bgColor === 'white' ? 'bg-white' : bgColor === 'gray' ? 'bg-gray-50' : '';
const bgStyle = bgColor !== 'white' && bgColor !== 'gray' ? `background-color: ${bgColor};` : '';

// ... existing helper functions ...

const getTextColorStyle = (color?: ColorName): string => {
// ... existing helper functions ...
  if (!color) return '';
  if (colors[color as keyof typeof colors]) {
    return `color: ${colors[color as keyof typeof colors]} !important;`;
  }
  return `color: ${color} !important;`;
};

const titleColorStyle = getTextColorStyle(titleColor);
const textColorStyle = getTextColorStyle(textColor);
const labelColorStyle = labelColor === 'rose' 
  ? `color: ${colors.rose} !important;` 
  : labelColor === 'white' 
  ? `color: ${colors.white} !important;` 
  : `color: ${colors.green} !important;`;
const alignClass = textAlign === 'top' ? 'items-start' : textAlign === 'bottom' ? 'items-end' : 'items-center';

const imageOrder = imagePosition === 'right' ? 'order-2 md:order-2' : 'order-2 md:order-1';
const textOrder = imagePosition === 'right' ? 'order-3 md:order-1' : 'order-3 md:order-2';

const imageShapeClass = imageShape === 'organic' 
  ? 'rounded-[60%_40%_30%_70%/60%_30%_70%_40%]' 
  : 'rounded-xl';
---

<section class={`py-16 md:py-20 ${bgClass} ${className}`} style={bgStyle}>
  <div class="max-w-6xl mx-auto px-6">
    <div class={`grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 ${alignClass}`}>
      {/* 모바일에서만 보이는 타이틀 (order-1) */}
      {(label || title) && (
        <div class="w-full order-1 md:hidden text-center" style={textColorStyle}>
          {label && (
            <h6 class="mb-3 font-bold uppercase tracking-wider" style={labelColorStyle}>{label}</h6>
          )}
          {title && (
            <TitleTag class="mb-6" style={titleColorStyle} set:html={title} />
          )}
        </div>
      )}
      {/* 이미지 (모바일: order-2, 데스크톱: imagePosition에 따라) */}
      {image && (
        <div class={`w-full ${imageOrder}`}>
          <div class={`w-full aspect-square overflow-hidden ${imageShapeClass}`}>
            {typeof image === 'string' ? (
              <img 
                src={image} 
                alt={imageAlt} 
                class="w-full h-full object-cover opacity-0 translate-y-5 transition-all duration-[800ms] ease-out" 
                data-fade="true"
                data-delay="400"
              />
            ) : (
              <Image 
                src={image} 
                alt={imageAlt} 
                class="w-full h-full object-cover opacity-0 translate-y-5 transition-all duration-[800ms] ease-out" 
                data-fade="true"
                data-delay="400"
              />
            )}
          </div>
        </div>
      )}
      {/* 텍스트 컨텐츠 (모바일: order-3, 데스크톱: imagePosition에 따라) */}
      <div class={`w-full text-center md:text-left ${image ? textOrder : 'order-2 md:order-none'}`} style={textColorStyle}>
        {/* 데스크톱에서만 보이는 타이틀 */}
        <div class="hidden md:block">
          {label && (
            <h6 class="mb-3 font-bold uppercase tracking-wider" style={labelColorStyle}>{label}</h6>
          )}
          {title && (
            <TitleTag class="mb-6" style={titleColorStyle} set:html={title} />
          )}
        </div>
        {/* Description */}
        {description && (
          <h6 class="mb-3 font-normal leading-relaxed" set:html={description} />
        )}
        {descriptionList && descriptionList.length > 0 && (
          <ul class="mb-3 font-normal list-disc list-inside space-y-2" style={textColorStyle}>
            {descriptionList.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        )}
        <slot />
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fadeElements = document.querySelectorAll('[data-fade="true"]');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const el = entry.target as HTMLElement;
        const delay = el.dataset.delay || '0';

        if (entry.isIntersecting) {
          setTimeout(() => {
            el.classList.remove('opacity-0', 'translate-y-5');
            el.classList.add('opacity-100', 'translate-y-0');
          }, parseInt(delay));
        } else {
          el.classList.remove('opacity-100', 'translate-y-0');
          el.classList.add('opacity-0', 'translate-y-5');
        }
      });
    }, {
      threshold: 0.1
    });

    fadeElements.forEach((el) => observer.observe(el));
  });
</script>

