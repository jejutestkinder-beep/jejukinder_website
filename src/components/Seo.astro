---
import { SEO } from 'astro-seo';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical?: string;
  openGraph?: {
    title?: string;
    description?: string;
    image?: string;
    url?: string;
    type?: string;
  };
  twitterCard?: {
    title?: string;
    description?: string;
    image?: string;
    card?: 'summary' | 'summary_large_image';
  };
}

const {
  title,
  description,
  keywords = "제주 발도르프, 제주 어린이집, 숲유치원, 제주 숲나들이, 한경면 어린이집, 제주 대안 교육",
  canonical,
  openGraph,
  twitterCard
} = Astro.props;

const toString = (value: unknown) => (typeof value === 'string' ? value : value == null ? '' : String(value));

// 기본 사이트 URL (환경 변수나 설정에서 가져올 수 있음)
const siteUrl = Astro.site?.href || 'https://your-site.com';
const currentUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;

// Open Graph 기본값 설정
const ogTitle = toString(openGraph?.title || title);
const ogDescription = toString(openGraph?.description || description);
const ogImage = toString(openGraph?.image || `${siteUrl}/seo-image.jpg`);
const ogUrl = toString(openGraph?.url || currentUrl);
const ogType = toString(openGraph?.type || 'website');

// Twitter Card 기본값 설정
const twitterTitle = toString(twitterCard?.title || title);
const twitterDescription = toString(twitterCard?.description || description);
const twitterImage = toString(twitterCard?.image || ogImage);
const twitterCardType = twitterCard?.card || 'summary_large_image';
const safeTitle = toString(title);
const safeDescription = toString(description);
const safeKeywords = toString(keywords);
const safeCanonical = toString(canonical || currentUrl);
---

<SEO
  title={safeTitle}
  description={safeDescription}
  canonical={safeCanonical}
  extend={{
    meta: [
      { name: 'keywords', content: safeKeywords },
    ],
  }}
  openGraph={{
    basic: {
      title: ogTitle,
      type: ogType,
      image: ogImage,
      url: ogUrl,
    },
    optional: {
      description: ogDescription,
    }
  }}
  twitter={{
    card: twitterCardType,
    title: twitterTitle,
    description: twitterDescription,
    image: twitterImage,
  }}
/>

