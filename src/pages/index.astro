---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import HeroIndex from '../components/HeroIndex.astro';
import Content2Col from '../components/Content2Col.astro';
import Content3Col from '../components/Content3Col.astro';
import ContactSection from '../components/ContactSection.astro';
import NoticePopup from '../components/NoticePopup.astro';

// Hero Images
import hero01 from '../assets/index-hero-01.avif';
import hero02 from '../assets/index-hero-02.avif';
import hero04 from '../assets/index-hero-04.avif';
import hero05 from '../assets/index-hero-05.avif';
import hero06 from '../assets/index-hero-06.jpeg';

// Section Images
import space01 from '../assets/index-space-01.avif';
import space02 from '../assets/index-space-02.avif';
import space03 from '../assets/index-space-03.avif';

import nature01 from '../assets/index-nature-01.avif';
import nature02 from '../assets/index-nature-02.avif';
import nature03 from '../assets/index-nature-03.avif';

import art01 from '../assets/index-art-01.avif';

// Patterns
import pattern01 from '../assets/index-pattern-01.avif';
import pattern02 from '../assets/index-pattern-02.avif';
import pattern03 from '../assets/index-pattern-03.avif';
import pattern04 from '../assets/index-pattern-04.avif';
import pattern05 from '../assets/index-pattern-05.avif';
import pattern06 from '../assets/index-pattern-06.avif';

const notices = await getCollection('notices');

const popupCandidates = notices
  .filter((n) => n.data.popup === true)
  .filter((n) => {
    const anyData = n.data as any;
    const until = anyData.popup_until;
    if (!until) return true;
    try {
      const untilMs = until instanceof Date ? until.getTime() : new Date(until).getTime();
      return Date.now() <= untilMs;
    } catch {
      return true;
    }
  });

popupCandidates.sort((a, b) => (a.slug < b.slug ? 1 : a.slug > b.slug ? -1 : 0));

// 최대 2개까지만 표시
const limitedCandidates = popupCandidates.slice(0, 2);

const popupNotices = await Promise.all(
  limitedCandidates.map(async (notice) => {
    const rendered = await notice.render();
    return {
      notice,
      Content: rendered.Content
    };
  })
);
---

<Layout 
  title="제주 발도르프 어린이집 - 자연과 함께하는 발도르프 교육"
  description="아이들이 꽃처럼 피어나는 곳, 아이의 발달 과정에 맞추어 섬세하게 아이를 키우는 제주 발도르프 어린이집입니다. 오름으로, 곶자왈로 자연과 만나는 숲유치원 형태의 발도르프 교육 공동체입니다."
  keywords="제주 발도르프 어린이집, 제주 발도르프, 제주 숲유치원, 한경면 어린이집, 제주 어린이집, 숲체험, 제주 발도르프 킨더"
  naverVerification="bb450b666d48a8f3962cb3ad50aa34a6d4ca0c29"
>
  {popupNotices.map(({ notice, Content }, index) => (
    <NoticePopup notice={notice} Content={Content} index={index} />
  ))}

  <HeroIndex
    images={[hero01, hero02, hero06, hero04, hero05]}
    subtitle="아이들이 꽃처럼 피어나는 곳"
    title="제주발도르프어린이집"
    ctaText="입소 상담하기"
    ctaLink="https://docs.google.com/forms/d/e/1FAIpQLSccyRwbI42sdBHoiWLcz7A-BywQAY7I7ce_NVQUo6puvjFsVA/viewform"
  />

  <div class="relative overflow-hidden">
    <div class="absolute top-[10%] left-[-5%] w-40 md:w-64 h-40 md:h-64 opacity-100 pointer-events-none z-0">
      <Image src={pattern01} alt="" class="w-full h-full object-contain" />
    </div>
    <div class="absolute top-0 right-[-2%] w-48 md:w-64 h-48 md:h-64 opacity-100 pointer-events-none z-0 -rotate-[20deg]">
      <Image src={pattern02} alt="" class="w-full h-full object-contain" />
    </div>
    <div class="absolute bottom-[5%] right-[-5%] w-48 md:w-72 h-48 md:h-72 opacity-100 pointer-events-none z-0">
      <Image src={pattern06} alt="" class="w-full h-full object-contain" />
    </div>
    <Content3Col
      title="아름다운 공간에서"
      titleColor="brown"
      description="교사와 학부모와 아이들이 꾸민 아름다움 속에서,<br />아이들은 매일 영감을 받습니다."
      descriptionColor="black"
      images={[
        { src: space01, alt: "공간 1" },
        { src: space02, alt: "공간 2" },
        { src: space03, alt: "공간 3" }
      ]}
    />
  </div>

  <Content2Col
    title="예술적인 교육을"
    titleColor="brown"
    description="아이의 발달 단계에 맞는 아름다운 예술 활동을 통해<br />  창의력을 기릅니다."
    image={art01}
    imageAlt="예술 교육"
    imageShape="organic"
    bgColor="ivory"
    imagePosition="left"
    pattern={pattern03}
    pattern2={pattern06}
  />

  <div class="relative overflow-hidden">
    <div class="absolute top-[5%] left-[-5%] w-40 md:w-64 h-40 md:h-64 opacity-100 pointer-events-none z-0">
      <Image src={pattern03} alt="" class="w-full h-full object-contain" />
    </div>
    <div class="absolute bottom-[5%] right-[-5%] w-56 md:w-80 h-56 md:h-80 opacity-100 pointer-events-none z-0">
      <Image src={pattern04} alt="" class="w-full h-full object-contain" />
    </div>
    <Content3Col
      title="자연과 더불어"
      titleColor="brown"
      description="제주의 너른 자연 안에서,<br />아이들은 매일 배우고 자랍니다."
      images={[
        { src: nature01, alt: "자연 1" },
        { src: nature02, alt: "자연 2" },
        { src: nature03, alt: "자연 3" }
      ]}
    />
  </div>

  <ContactSection
    title="제주발도르프어린이집이 궁금하세요?"
    titleColor="brown"
    bgColor="lightPink"
    Button="입소 상담은 여기로"
    linkUrl="https://docs.google.com/forms/d/e/1FAIpQLSccyRwbI42sdBHoiWLcz7A-BywQAY7I7ce_NVQUo6puvjFsVA/viewform"
    noBottomPadding={true}
    patternLeft={pattern05}
    patternRight={pattern04}
  />
</Layout>
