---
import Navigation from '../components/navigation.astro';
import Footer from '../components/SiteFooter.astro';
import Seo from '../components/Seo.astro';
import Schema from '../components/Schema.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  openGraph?: {
    title?: string;
    description?: string;
    image?: string;
    url?: string;
    type?: string;
  };
  twitterCard?: {
    title?: string;
    description?: string;
    image?: string;
    card?: 'summary' | 'summary_large_image';
  };
  keywords?: string;
  schemaType?: 'School' | 'Organization' | 'LocalBusiness' | 'Article';
  schemaData?: any;
  naverVerification?: string;
}

const { 
  title = '제주 발도르프 어린이집',
  description = '제주 발도르프 어린이집',
  canonical,
  openGraph,
  twitterCard,
  keywords,
  schemaType = 'Organization',
  schemaData = {
    "name": "제주발도르프어린이집",
    "alternateName": ["제주 발도르프 어린이집", "제주발도르프"],
    "description": "제주도에 위치한 발도르프 교육 철학을 실천하는 어린이집입니다.",
    "url": "https://jejuwaldorf-kinder.com",
    "logo": "https://jejuwaldorf-kinder.com/favicon.svg",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "제주특별자치도",
      "addressCountry": "KR"
    }
  },
  naverVerification
} = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		{naverVerification && <meta name="naver-site-verification" content={naverVerification} />}

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
		
		<Seo
			title={title}
			description={description}
			keywords={keywords}
			canonical={canonical}
			openGraph={openGraph}
			twitterCard={twitterCard}
		/>

		<Schema type={schemaType} data={schemaData} />
	</head>

	<body>
		<Navigation />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style>
	html {
		margin: 0;
		width: 100%;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
		overflow-x: clip; /* Modern way to hide overflow without breaking sticky */
	}

	main {
		width: 100%;
	}

	/* Responsive Breakpoints - Remove main padding to allow full-width sections */
	@media (max-width: 1024px) {
		main {
			padding: 0;
		}
	}

	@media (max-width: 768px) {
		main {
			padding: 0;
		}
	}

	@media (max-width: 480px) {
		main {
			padding: 0;
		}
	}
</style>