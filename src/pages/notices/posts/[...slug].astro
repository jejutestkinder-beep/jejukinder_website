---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { normalizeUploadPath } from '../../../utils/image';

export async function getStaticPaths() {
  const posts = await getCollection('notices');
  return posts.map((entry) => ({
    params: { slug: entry.slug }
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/notices/');
}

const entry = await getEntry('notices', slug);

if (!entry) {
  return Astro.redirect('/notices/');
}

const { Content } = await entry.render();

const seoData = {
  title: entry.data.title,
  description: entry.data.seo_description || entry.body.substring(0, 160),
  keywords: entry.data.keywords,
  openGraph: {
    title: entry.data.title,
    description: entry.data.seo_description || entry.body.substring(0, 160),
    image: entry.data.image ? normalizeUploadPath(entry.data.image) : undefined
  }
};
---

<Layout {...seoData} schemaType="Article">
  <div class="max-w-4xl mx-auto py-12 px-6">
    <h1 class="text-4xl md:text-5xl font-bold mb-2">{entry.data.title}</h1>
    <div class="flex items-center gap-4 text-gray-500 mb-12 pb-8 border-b border-gray-100">
      <span>작성자: {entry.data.author}</span>
      {entry.data.date && (
        <>
          <span>·</span>
          <span>{new Date(entry.data.date).toLocaleDateString('ko-KR')}</span>
        </>
      )}
    </div>

    <article class="prose max-w-none mb-16 prose-img:max-w-[800px] prose-img:w-full prose-img:mx-auto prose-img:rounded-xl">
      <Content />
    </article>

    <div class="text-center">
      <a href="/notices/" class="btn btn-secondary">목록으로 돌아가기</a>
    </div>
  </div>
</Layout>
