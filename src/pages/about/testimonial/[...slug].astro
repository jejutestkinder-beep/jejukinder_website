---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/Hero.astro';
import test1 from '../../../assets/hero-testimonial-reviews.jpeg';
import { normalizeUploadPath } from '../../../utils/image';

export async function getStaticPaths() {
  const testimonials = await getCollection('testimonial');
  return testimonials.map((entry) => ({
    params: { slug: entry.slug }
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/about/testimonial/');
}

const entry = await getEntry('testimonial', slug);

if (!entry) {
  return Astro.redirect('/about/testimonial/');
}

const { Content } = await entry.render();

const seoData = {
  title: `${entry.data.title} | 제주발도르프어린이집 후기`,
  description: entry.data.seo_description || entry.body.substring(0, 160),
  keywords: entry.data.keywords,
  openGraph: {
    title: entry.data.title,
    description: entry.data.seo_description || entry.body.substring(0, 160),
    image: entry.data.image ? normalizeUploadPath(entry.data.image) : undefined
  }
};
---

<Layout {...seoData} schemaType="Article">
  <Hero
    image={test1}
    title="어린이집 후기"
    imageAlt="어린이집 후기"
    description="어린이집을 졸업한 아이와 학부모님들의 이야기입니다."
  />

  <div class="max-w-4xl mx-auto py-20 px-6">
    <div class="mb-12 text-center">
      <div class="text-custom-rose font-medium mb-4">{entry.data.author}</div>
      <h1 class="text-5xl md:text-5xl font-bold mb-6">{entry.data.title}</h1>
      <div class="text-gray-400 text-sm">
        {entry.data.date && new Date(entry.data.date).toLocaleDateString('ko-KR')}
      </div>
    </div>

    <article class="prose max-w-none mb-20 prose-headings:text-custom-brown prose-p:text-gray-700 prose-a:text-custom-rose prose-img:max-w-[800px] prose-img:w-full prose-img:mx-auto prose-img:rounded-xl">
      <Content />
    </article>

    <div class="text-center pt-10 border-t border-gray-100">
      <a href="/about/testimonial/" class="btn btn-secondary">목록으로 돌아가기</a>
    </div>
  </div>
</Layout>
