---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/notices/');
}

const entry = await getEntry('notices', slug);

if (!entry) {
  return Astro.redirect('/notices/');
}

const { Content } = await entry.render();

// entry.body를 안전하게 문자열로 변환
const bodyText = typeof entry.body === 'string' ? entry.body : String(entry.body || '');
const descriptionText = bodyText.replace(/[#*`\[\]()]/g, '').substring(0, 160).trim();
const description = entry.data.seo_description || descriptionText || entry.data.title;

const seoData = {
  title: entry.data.title,
  description: description,
  keywords: entry.data.keywords,
  openGraph: {
    title: entry.data.title,
    description: description,
    image: entry.data.image || undefined
  }
};
---

<Layout {...seoData} schemaType="Article">
  <div class="max-w-4xl mx-auto py-12 px-6">
    <h1 class="mb-2">{entry.data.title}</h1>
    <div class="flex items-center gap-4 text-gray-500 mb-12 pb-8 border-b border-gray-100">
      <span>작성자: {entry.data.author}</span>
      {entry.data.date && (
        <>
          <span>·</span>
          <span>{new Date(entry.data.date).toLocaleDateString('ko-KR')}</span>
        </>
      )}
    </div>

    <article class="prose max-w-none mb-16">
      <Content />
    </article>

    <div class="text-center">
      <a href="/notices/" class="btn btn-secondary">목록으로 돌아가기</a>
    </div>
  </div>
</Layout>
